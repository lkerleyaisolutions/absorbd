# Copy this file to .env and fill in your values. NEVER commit .env.

# Azure AI Foundry Project
PROJECT_ENDPOINT=               # https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=          # https://<resource>.openai.azure.com/openai/v1
AZURE_AI_PROJECT_API_KEY=
MODEL_DEPLOYMENT=gpt-4.1-mini   # gpt-4.1-mini: has quota + is the model in Microsoft's Foundry IQ docs
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search (Foundry IQ knowledge base)
AZURE_SEARCH_ENDPOINT=          # https://<your-search-name>.search.windows.net
AZURE_SEARCH_KEY=
KNOWLEDGE_BASE_NAME=absorb-iq-kb

# Foundry IQ MCP integration (these are FIXED per Microsoft docs - do not change)
# Tool name: the only supported tool is knowledge_base_retrieve
# Endpoint pattern: {AZURE_SEARCH_ENDPOINT}/knowledgebases/{KNOWLEDGE_BASE_NAME}/mcp?api-version=2026-05-01-preview
FOUNDRY_IQ_MCP_TOOL=knowledge_base_retrieve
PROJECT_CONNECTION_NAME=absorb-iq-kb-mcp-connection

# Project ARM resource ID (needed to create the RemoteTool connection)
# Format: /subscriptions/.../resourceGroups/.../providers/Microsoft.CognitiveServices/accounts/.../projects/...
PROJECT_RESOURCE_ID=

# Azure AI Content Safety (groundedness checks)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
